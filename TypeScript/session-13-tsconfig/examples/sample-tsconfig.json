{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_comment": "نمونهٔ آموزشی — فایل فعال دوره TypeScript/tsconfig.json است",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["../session-*/examples/**/*.ts"]
}
