:: =====================================================================
:: جلسه 03 - متغیرها (set)
:: =====================================================================
@echo off
set name=Saeed
set city=Tehran

echo نام: %name%
echo شهر: %city%

:: تغییر مقدار یک متغیر
set name=Ali
echo نام جدید: %name%

:: ترکیب چند متغیر در یک رشته
set fullinfo=%name% از %city%
echo اطلاعات کامل: %fullinfo%

:: تمرین: سه متغیر برای نام کتاب، نویسنده و سال انتشار بسازید و همه را در یک خط چاپ کنید.
