:: =====================================================================
:: جلسه 07 - مقایسه رشته‌ها
:: =====================================================================
@echo off
set /p answer=آیا پایتون بلدید؟ (yes/no): 

if "%answer%"=="yes" (
    echo عالی، پس بریم سراغ خودکارسازی!
) else if "%answer%"=="no" (
    echo مشکلی نیست، از همینجا شروع می‌کنیم.
) else (
    echo پاسخ نامعتبر بود.
)

:: مقایسه بدون حساسیت به بزرگی/کوچکی حروف با /i
if /i "%answer%"=="YES" (
    echo تطابق بدون توجه به کوچک/بزرگ حروف کار کرد.
)

:: تمرین: از کاربر رنگ مورد علاقه‌اش را بپرسید و اگر "آبی" بود پیام خاصی چاپ کنید.
