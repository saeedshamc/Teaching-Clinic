:: =====================================================================
:: جلسه 05 - ورودی کاربر (set /p)
:: =====================================================================
@echo off
set /p username=نام کاربری خود را وارد کنید: 
set /p age=سن خود را وارد کنید: 

echo.
echo سلام %username%! شما %age% سال دارید.

set /p confirm=آیا اطلاعات درست است؟ (y/n): 
if /i "%confirm%"=="y" (
    echo اطلاعات تایید شد.
) else (
    echo لطفا دوباره اجرا کنید.
)

:: تمرین: از کاربر دو عدد بگیرید و مجموع آن‌ها را با set /a محاسبه و چاپ کنید.
