:: =====================================================================
:: جلسه 10 - حلقه عددی FOR /L
:: =====================================================================
@echo off
echo شمارش از 1 تا 5:
for /L %%i in (1,1,5) do (
    echo عدد: %%i
)

echo.
echo شمارش معکوس از 10 تا 1:
for /L %%i in (10,-1,1) do (
    echo %%i
)

echo.
echo فقط اعداد زوج از 2 تا 10:
for /L %%i in (2,2,10) do (
    echo زوج: %%i
)

:: تمرین: با FOR /L جدول ضرب عدد ۷ (از ۱ تا ۱۰) را چاپ کنید.
