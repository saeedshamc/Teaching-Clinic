:: =====================================================================
:: جلسه 27 - نوشتن در فایل با > و >>
:: =====================================================================
@echo off
:: > فایل را بازنویسی می‌کند (محتوای قبلی پاک می‌شود)
echo این خط اول است > output.txt

:: >> به انتهای فایل اضافه می‌کند (بدون پاک کردن)
echo این خط دوم است >> output.txt
echo این خط سوم است >> output.txt

echo محتوای فایل:
type output.txt

del output.txt

:: تمرین: اسکریپتی بسازید که ۵ خط شامل شماره ردیف در یک فایل بنویسد (با حلقه FOR /L و >>).
