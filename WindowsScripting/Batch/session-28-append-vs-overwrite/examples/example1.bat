:: =====================================================================
:: جلسه 28 - تمرین عملی تفاوت overwrite و append
:: =====================================================================
@echo off
echo نسخه اول > log.txt
type log.txt
echo.
echo === اجرای مجدد با >> ===
echo نسخه دوم >> log.txt
type log.txt
echo.
echo === اجرای مجدد با > (بازنویسی کامل) ===
echo فقط این باقی می‌ماند > log.txt
type log.txt

del log.txt

:: نکته امنیتی: همیشه قبل از استفاده از > روی فایل‌های مهم، مطمئن شوید محتوای قبلی نیاز نیست.

:: تمرین: یک اسکریپت لاگر بسازید که هر بار اجرا می‌شود، یک خط جدید (با >>) اضافه کند نه بازنویسی.
