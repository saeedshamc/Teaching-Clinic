:: =====================================================================
:: جلسه 22 - برش رشته با %var:~start,length%
:: =====================================================================
@echo off
set str=HelloBatchWorld

echo رشته کامل: %str%
echo 5 کاراکتر اول: %str:~0,5%
echo از کاراکتر 5 تا انتها: %str:~5%
echo 5 کاراکتر آخر: %str:~-5%
echo از وسط: %str:~5,5%

:: کاربرد عملی: گرفتن سال از تاریخ سیستم
echo سال جاری از %%date%%: %date:~-4%

:: تمرین: از یک شماره کارت فرضی ۱۶ رقمی، فقط ۴ رقم آخر را نمایش دهید.
