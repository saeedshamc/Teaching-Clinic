:: =====================================================================
:: جلسه 38 - دستورات پایه شبکه
:: =====================================================================
@echo off
echo بررسی اتصال اینترنت:
ping -n 2 8.8.8.8

echo.
echo نمایش تنظیمات IP:
ipconfig

echo.
echo بررسی چند سرور به‌صورت خودکار:
for %%s in (google.com github.com) do (
    ping -n 1 -w 1000 %%s >nul
    if !errorlevel! equ 0 (
        echo %%s در دسترس است
    ) else (
        echo %%s در دسترس نیست
    )
)

:: تمرین: اسکریپتی بسازید که فقط آدرس IPv4 سیستم را (بدون بقیه اطلاعات ipconfig) استخراج و چاپ کند.
