:: =====================================================================
:: جلسه 09 - شرط‌های تودرتو
:: =====================================================================
@echo off
set /p age=سن خود را وارد کنید: 
set /p license=آیا گواهینامه دارید؟ (y/n): 

if %age% geq 18 (
    if /i "%license%"=="y" (
        echo می‌توانید رانندگی کنید.
    ) else (
        echo سن کافی است ولی گواهینامه ندارید.
    )
) else (
    echo سن کافی برای رانندگی نیست.
)

:: تمرین: با دو شرط تودرتو، یک سیستم ساده‌ی "آیا واجد شرایط وام هستید؟" بسازید (سن بالای ۲۱ و درآمد بالای عددی مشخص).
