:: پاسخ تمرین - جلسه 9: شرط‌های تودرتو
:: این یکی از راه‌حل‌های ممکن است؛ راه‌حل‌های دیگر هم می‌توانند درست باشند.

@echo off
set /p age=سن خود را وارد کنید: 
set /p income=درآمد ماهانه خود را وارد کنید: 

if %age% gtr 21 (
    if %income% gtr 5000000 (
        echo واجد شرایط وام هستید.
    ) else (
        echo سن کافی است ولی درآمد کافی نیست.
    )
) else (
    echo سن کافی برای دریافت وام نیست.
)
