:: =====================================================================
:: جلسه 40 - مدیریت خطا
:: =====================================================================
@echo off
copy nonexistent_file.txt destination.txt 2>nul
if %errorlevel% neq 0 (
    echo خطا: کپی ناموفق بود ^(کد خطا: %errorlevel%^)
) else (
    echo کپی موفق بود.
)

echo.
echo بررسی موفقیت یک عملیات شبکه:
ping -n 1 -w 500 1.2.3.4 >nul 2>&1
if %errorlevel% equ 0 (
    echo سرور در دسترس است
) else (
    echo سرور در دسترس نیست یا timeout شد
)

:: نکته: بعضی دستورات errorlevel درستی برنمی‌گردانند؛ همیشه با یک تست ساده بررسی کنید.

:: تمرین: اسکریپتی بسازید که تلاش کند یک پوشه‌ی غیرموجود را حذف کند و خطا را با پیام مناسب مدیریت کند.
