:: =====================================================================
:: جلسه 32 - تاریخ و ساعت سیستم
:: =====================================================================
@echo off
echo تاریخ کامل: %date%
echo ساعت کامل: %time%

:: استخراج بخش‌های تاریخ (فرمت به تنظیمات ویندوز بستگی دارد)
for /f "tokens=1-3 delims=/" %%a in ("%date%") do (
    set day=%%a
    set month=%%b
    set year=%%c
)
echo روز: %day%  ماه: %month%  سال: %year%

:: ساخت نام فایل بر اساس تاریخ
set filename=backup_%date:~-4%%date:~3,2%%date:~0,2%.txt
echo نام فایل پیشنهادی: %filename%

:: تمرین: اسکریپتی بسازید که یک فایل لاگ با نام شامل تاریخ و ساعت فعلی بسازد.
