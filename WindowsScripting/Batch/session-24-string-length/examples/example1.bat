:: =====================================================================
:: جلسه 24 - محاسبه طول رشته (بدون تابع مستقیم؛ با ترفند)
:: =====================================================================
@echo off
setlocal enabledelayedexpansion
set str=HelloWorld
set len=0

:count_loop
if not "!str:~%len%,1!"=="" (
    set /a len+=1
    goto count_loop
)

echo طول رشته "%str%" برابر است با: %len%

:: Batch دستور مستقیم length ندارد؛ این تکنیک با بررسی کاراکتر به کاراکتر طول را حساب می‌کند.

:: تمرین: طول رشته‌ای که کاربر با set /p وارد می‌کند را محاسبه و چاپ کنید.
