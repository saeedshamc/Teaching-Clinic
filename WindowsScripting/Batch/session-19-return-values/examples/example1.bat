:: =====================================================================
:: جلسه 19 - شبیه‌سازی بازگشت مقدار با errorlevel
:: =====================================================================
@echo off
call :is_even 8
if %errorlevel% equ 0 (
    echo عدد زوج است
) else (
    echo عدد فرد است
)
goto :eof

:is_even
set /a remainder=%1 %% 2
if %remainder% equ 0 (
    exit /b 0
) else (
    exit /b 1
)

:: exit /b <کد> کد بازگشتی زیربرنامه یا کل اسکریپت را تنظیم می‌کند (۰ یعنی موفق، طبق قرارداد).

:: تمرین: تابعی بسازید که بررسی کند عدد ورودی مثبت است یا منفی، و از طریق errorlevel نتیجه را برگرداند.
