:: =====================================================================
:: جلسه 17 - CALL برای فراخوانی زیربرنامه
:: =====================================================================
@echo off
call :print_header
echo محتوای اصلی برنامه اینجاست
call :print_footer
goto :eof

:print_header
echo ===================================
echo         برنامه من - نسخه 1
echo ===================================
exit /b

:print_footer
echo ===================================
echo         پایان اجرا
echo ===================================
exit /b

:: نکته: goto :eof یعنی رفتن به انتهای فایل و پایان اجرای بخش اصلی.
:: exit /b از داخل یک زیربرنامه فقط همان زیربرنامه را تمام می‌کند و به نقطه فراخوانی برمی‌گردد.

:: تمرین: زیربرنامه‌ای به نام :confirm_exit بسازید که از کاربر بپرسد مطمئن است می‌خواهد خارج شود یا نه.
