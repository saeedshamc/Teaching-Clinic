:: =====================================================================
:: جلسه 13 - جداسازی ستون‌ها با tokens و delims
:: =====================================================================
@echo off
set line=John,25,Tehran

for /f "tokens=1,2,3 delims=," %%a in ("%line%") do (
    echo نام: %%a
    echo سن: %%b
    echo شهر: %%c
)

echo.
echo پیمایش خروجی یک دستور سیستمی:
for /f "tokens=2 delims=:" %%a in ('ipconfig ^| findstr IPv4') do (
    echo آدرس IP: %%a
)

:: نکته: برای استفاده از خروجی یک دستور، آن را داخل تک‌کوتیشن ' ' می‌گذاریم و از ^| برای escape کردن | استفاده می‌کنیم.

:: تمرین: رشته‌ی "apple;banana;cherry" را با delims=; تجزیه کنید و هر میوه را در خط جدا چاپ کنید.
