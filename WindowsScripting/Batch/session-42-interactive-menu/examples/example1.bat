:: =====================================================================
:: جلسه 42 - ساخت منوی تعاملی
:: =====================================================================
@echo off
:menu
cls
echo ================================
echo          منوی اصلی
echo ================================
echo 1. نمایش تاریخ و ساعت
echo 2. نمایش اطلاعات سیستم
echo 3. پاکسازی صفحه
echo 4. خروج
echo ================================
set /p choice=گزینه مورد نظر را انتخاب کنید: 

if "%choice%"=="1" (
    date /t & time /t
    pause
    goto menu
)
if "%choice%"=="2" (
    systeminfo | findstr /B /C:"OS Name" /C:"OS Version"
    pause
    goto menu
)
if "%choice%"=="3" goto menu
if "%choice%"=="4" (
    echo خدانگهدار!
    exit
)
echo گزینه نامعتبر!
pause
goto menu

:: تمرین: به منو یک گزینه پنجم اضافه کنید که مصرف فضای دیسک درایو C را نمایش دهد.
