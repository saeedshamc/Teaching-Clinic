:: =====================================================================
:: جلسه 12 - FOR /F برای خواندن خط به خط یک فایل یا رشته
:: =====================================================================
@echo off
echo Line One> sample.txt
echo Line Two>> sample.txt
echo Line Three>> sample.txt

echo خواندن خط به خط فایل:
for /f "delims=" %%l in (sample.txt) do (
    echo خط خوانده شد: %%l
)

del sample.txt

:: تمرین: فایلی با ۵ خط عدد بسازید و با FOR /F مجموع اعداد را محاسبه کنید (راهنمایی: از set /a داخل حلقه استفاده کنید).
