:: =====================================================================
:: جلسه 06 - شرط IF (مقایسه ساده)
:: =====================================================================
@echo off
set /a score=75

if %score% geq 90 (
    echo نمره: عالی
) else if %score% geq 70 (
    echo نمره: خوب
) else (
    echo نمره: نیاز به تلاش بیشتر
)

:: عملگرهای عددی: EQU برابر، NEQ نابرابر، LSS کوچکتر، LEQ کوچکتر مساوی، GTR بزرگتر، GEQ بزرگتر مساوی

:: تمرین: با گرفتن یک نمره از کاربر (set /p)، حرف نمره (A/B/C/D/F) را چاپ کنید.
