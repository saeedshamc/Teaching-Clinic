:: =====================================================================
:: جلسه 14 - پیمایش پوشه‌ها با FOR /D
:: =====================================================================
@echo off
mkdir TestArea 2>nul
cd TestArea
mkdir Folder1 Folder2 Folder3 2>nul

echo لیست زیرپوشه‌ها:
for /D %%d in (*) do (
    echo پوشه پیدا شد: %%d
)

cd ..
rmdir /s /q TestArea

:: تمرین: اسکریپتی بسازید که تعداد زیرپوشه‌های موجود در Documents (یا هر پوشه دلخواه) را بشمارد.
