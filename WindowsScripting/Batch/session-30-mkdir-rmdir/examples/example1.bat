:: =====================================================================
:: جلسه 30 - ساخت و حذف پوشه‌ها
:: =====================================================================
@echo off
mkdir Project
mkdir Project\src
mkdir Project\docs
mkdir Project\tests

echo ساختار پوشه ساخته شد:
dir Project /b

:: حذف یک پوشه خالی
rmdir Project\tests

:: حذف یک پوشه با تمام محتویاتش (بدون پرسش با /q)
rmdir /s /q Project

echo همه پوشه‌ها حذف شدند.

:: تمرین: ساختار پوشه‌ی استاندارد یک پروژه (src, docs, tests, assets) را با یک اسکریپت بسازید.
