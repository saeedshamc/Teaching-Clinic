:: =====================================================================
:: جلسه 04 - محاسبات عددی (set /a)
:: =====================================================================
@echo off
set /a a=10
set /a b=3

set /a sum=%a% + %b%
set /a diff=%a% - %b%
set /a mul=%a% * %b%
set /a div=%a% / %b%
set /a mod=%a% %% %b%

echo جمع: %sum%
echo تفریق: %diff%
echo ضرب: %mul%
echo تقسیم صحیح: %div%
echo باقیمانده: %mod%

:: نکته: در set /a علامت درصد باید دوبار نوشته شود (%%) چون یک % تنها به‌عنوان شروع متغیر تفسیر می‌شود.

:: تمرین: مساحت یک مستطیل را با گرفتن طول و عرض به‌صورت ثابت در کد محاسبه و چاپ کنید.
