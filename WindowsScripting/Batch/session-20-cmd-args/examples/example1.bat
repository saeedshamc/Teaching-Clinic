@echo off
:: اجرا: script.bat John 25 Tehran
echo نام: %1
echo سن: %2
echo شهر: %3
echo همه پارامترها با هم: %*

if "%1"=="" (
    echo هیچ پارامتری وارد نشد!
    echo استفاده صحیح: script.bat نام سن شهر
    exit /b 1
)

echo تعداد پارامترهای وارد شده به‌صورت دستی بررسی می‌شود...

:: تمرین: اسکریپتی بسازید که یک مسیر فایل را به‌عنوان پارامتر بگیرد و بررسی کند وجود دارد یا نه.
