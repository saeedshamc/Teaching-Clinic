:: =====================================================================
:: جلسه 11 - پیمایش فایل‌ها با FOR
:: =====================================================================
@echo off
echo لیست فایل‌های txt در پوشه فعلی:
for %%f in (*.txt) do (
    echo فایل پیدا شد: %%f
)

echo.
echo نمایش اندازه هر فایل:
for %%f in (*.txt) do (
    echo %%f - اندازه: %%~zf بایت
)

:: %%~zf اندازه فایل را برمی‌گرداند؛ %%~nf فقط نام بدون پسوند، %%~xf فقط پسوند است.

:: تمرین: تعداد کل فایل‌های .txt در پوشه فعلی را بشمارید و در پایان چاپ کنید.
