:: =====================================================================
:: جلسه 36 - tasklist و taskkill
:: =====================================================================
@echo off
echo لیست ۱۰ پروسه اول در حال اجرا:
tasklist | more +3 | findstr /n "^" | findstr "^[1-9]:\|^10:"

echo.
echo بررسی اینکه آیا notepad در حال اجراست:
tasklist | findstr /i "notepad.exe"
if %errorlevel% equ 0 (
    echo نوت‌پد در حال اجراست.
) else (
    echo نوت‌پد اجرا نشده است.
)

:: برای بستن یک پروسه: taskkill /IM notepad.exe /F
:: /F یعنی force (اجباری ببند)

:: تمرین: اسکریپتی بسازید که بررسی کند آیا chrome.exe در حال اجراست و پیام مناسب چاپ کند.
