:: =====================================================================
:: جلسه 16 - GOTO و Label
:: =====================================================================
@echo off
echo شروع برنامه
goto skip_section

echo این خط هرگز اجرا نمی‌شود
:skip_section
echo به اینجا پرش کردیم

:: مثال حلقه دستی با GOTO
set /a counter=0
:loop_start
set /a counter+=1
echo شمارنده: %counter%
if %counter% lss 5 goto loop_start

echo پایان حلقه

:: تمرین: با GOTO یک منوی ساده بسازید که بعد از انجام یک کار، دوباره به ابتدای منو برگردد.
