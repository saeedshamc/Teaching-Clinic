:: =====================================================================
:: جلسه 18 - توابع با پارامتر ورودی
:: =====================================================================
@echo off
call :greet "Saeed"
call :greet "Ali"
call :add_numbers 5 7
goto :eof

:greet
echo سلام %~1 عزیز، خوش آمدید!
exit /b

:add_numbers
set /a result=%1 + %2
echo مجموع %1 و %2 برابر است با: %result%
exit /b

:: %~1 پارامتر اول بدون کوتیشن است (برای رشته‌های دارای فاصله مفید است).

:: تمرین: تابعی به نام :multiply بسازید که دو عدد بگیرد و حاصلضرب را چاپ کند.
